      "checks": {
        "bitlocker_system": {
          "disposition": "Informational",
          "explanation": "BitLocker is recommended for protecting data at rest, but the Standard personal-desktop profile excludes it from the scored denominator by default."
        }
      }
    },
    "Advanced": {
      "description": "Stronger personal or professional endpoint baseline.",
      "checks": {
        "bitlocker_system": {
          "disposition": "Scored",
          "explanation": "The Advanced profile expects operating-system drive encryption and scores this check."
        }
      }
    },
    "Enterprise": {
      "description": "Organization-managed endpoint baseline. Customize the policy file to match approved organizational requirements.",
      "checks": {
        "bitlocker_system": {
          "disposition": "Scored",
          "explanation": "The Enterprise baseline scores operating-system drive encryption; organizational policy remains authoritative."
        }
      }
    }
  },
