#include <Windows.h>
#include "resource.h"

IDR_HELPER_MANIFEST RT_MANIFEST "helper.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_FILEVERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WinCur\0"
            VALUE "FileDescription", "WinCur Privileged Helper (non-mutating skeleton)\0"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "HelperVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "WinCur.PrivilegedHelper\0"
            VALUE "OriginalFilename", "WinCur.PrivilegedHelper.exe\0"
            VALUE "ProductName", "WinCur\0"
            VALUE "ProductVersion", VER_FILEVERSION_STR
            VALUE "ProtocolVersion", VER_PROTOCOLVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
